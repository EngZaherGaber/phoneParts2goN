      "settings": {
        "custom_liquid": "<style>\n  /* General Styling */\n  .process-container {\n    font-family: Arial, sans-serif;\n    line-height: 1.6;\n    color: #333;\n    max-width: 800px;\n    margin: 0 auto;\n    padding: 20px;\n    background: white;\n    border-radius: 10px;\n    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);\n  }\n\n  .process-container h1 {\n    font-size: 28px;\n    color: #2c3e50;\n    text-align: center;\n    margin-bottom: 20px;\n    background: linear-gradient(90deg, rgb(139 214 218), rgb(166 236 208));\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n  }\n\n  .process-steps {\n    display: flex;\n    flex-direction: column;\n    gap: 20px;\n  }\n\n  .step {\n    display: flex;\n    align-items: flex-start;\n    gap: 15px;\n    padding: 20px;\n    border: 1px solid #e0e0e0;\n    border-radius: 10px;\n    background: #f9f9f9;\n    transition: all 0.3s ease;\n  }\n\n  .step:hover {\n    transform: translateY(-5px);\n    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.1);\n  }\n\n  .step-icon {\n    width: 40px;\n    height: 40px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background: linear-gradient(90deg, rgb(139 214 218), rgb(166 236 208));\n    color: white;\n    border-radius: 50%;\n    font-size: 20px;\n    font-weight: bold;\n  }\n\n  .step-content {\n    flex: 1;\n  }\n\n  .step-content h3 {\n    font-size: 20px;\n    color: #2c3e50;\n    margin-bottom: 10px;\n  }\n\n  .step-content p {\n    font-size: 16px;\n    color: #555;\n    margin-bottom: 10px;\n  }\n\n  .step-content ul {\n    margin-bottom: 10px;\n    padding-left: 20px;\n  }\n\n  .step-content ul li {\n    margin-bottom: 5px;\n  }\n\n  .flow-buttons {\n    display: flex;\n    gap: 10px;\n    margin-top: 10px;\n  }\n\n  .flow-buttons button {\n    padding: 8px 16px;\n    border: none;\n    border-radius: 20px;\n    font-size: 14px;\n    font-weight: bold;\n    cursor: pointer;\n    transition: all 0.3s ease;\n  }\n\n  .flow-buttons button.approve {\n    background: linear-gradient(90deg, rgb(139 214 218), rgb(166 236 208));\n    color: white;\n  }\n\n  .flow-buttons button.denied {\n    background: #ff6b6b;\n    color: white;\n  }\n\n  .flow-buttons button:hover {\n    opacity: 0.9;\n  }\n\n  .flow-content {\n    display: none;\n    margin-top: 10px;\n    padding: 10px;\n    border-radius: 10px;\n    background: #f0f0f0;\n  }\n\n  .flow-content.approve {\n    border-left: 4px solid rgb(139 214 218);\n  }\n\n  .flow-content.denied {\n    border-left: 4px solid #ff6b6b;\n  }\n\n  .flow-content.active {\n    display: block;\n  }\n\n  /* Responsive Design */\n  @media (max-width: 768px) {\n    .process-container {\n      padding: 15px;\n    }\n\n    .step {\n      flex-direction: column;\n      align-items: center;\n      text-align: center;\n    }\n\n    .step-icon {\n      margin-bottom: 10px;\n    }\n\n    .flow-buttons {\n      justify-content: center;\n    }\n  }\n</style>\n\n<div class=\"process-container\">\n  <h1>RMA Process</h1>\n  <div class=\"process-steps\">\n    <!-- Step 1 -->\n    <div class=\"step\">\n      <div class=\"step-icon\">1</div>\n      <div class=\"step-content\">\n        <h3>Find Your Order</h3>\n        <p>Log into your account in the webshop to find your order.</p>\n      </div>\n    </div>\n\n    <!-- Step 2 -->\n    <div class=\"step\">\n      <div class=\"step-icon\">2</div>\n      <div class=\"step-content\">\n        <h3>Create New RMA</h3>\n        <p>\n          Create a new RMA. Please add as many photos and videos as possible to\n          assist with the process.\n        </p>\n      </div>\n    </div>\n\n    <!-- Step 3 -->\n    <div class=\"step\">\n      <div class=\"step-icon\">3</div>\n      <div class=\"step-content\">\n        <h3>Wait for approval</h3>\n        <p>Wait for approval via emaill before shipping.</p>\n        <div class=\"flow-buttons\">\n          <button class=\"approve\" onclick=\"showFlow('step3', 'approve')\">\n            Approve\n          </button>\n          <button class=\"denied\" onclick=\"showFlow('step3', 'denied')\">\n            Denied\n          </button>\n        </div>\n        <div id=\"step3-approve\" class=\"flow-content approve\">\n          <p>\n            <strong>Approved:</strong> Proceed to the \"Print Packing Slip\" step.\n          </p>\n        </div>\n        <div id=\"step3-denied\" class=\"flow-content denied\">\n          <p><strong>Denied:</strong> Don't send the products</p>\n        </div>\n      </div>\n    </div>\n\n\n    <!-- Step 5 -->\n    <div class=\"step\">\n      <div class=\"step-icon\">5</div>\n      <div class=\"step-content\">\n        <h3>Print Packing Slip</h3>\n        <p>\n          Print the packing slip, wrap it in the document, and add it to the\n          address as instructed in the email.\n        </p>\n      </div>\n    </div>\n\n    <!-- Step 6 -->\n    <div class=\"step\">\n      <div class=\"step-icon\">6</div>\n      <div class=\"step-content\">\n        <h3>Receive Items</h3>\n        <p>\n          Once we receive the items, we will mark the RMA as received in the\n          system and prepare it to be checked by our technicians.\n        </p>\n      </div>\n    </div>\n\n    <!-- Step 7 -->\n    <div class=\"step\">\n      <div class=\"step-icon\">7</div>\n      <div class=\"step-content\">\n        <h3>RMA Engineer Check</h3>\n        <p>\n          An RMA engineer will check your return. Details like your information,\n          photos, and videos provided will help resolve the process.\n        </p>\n        <div class=\"flow-buttons\">\n          <button class=\"approve\" onclick=\"showFlow('step7', 'approve')\">\n            Approve\n          </button>\n          <button class=\"denied\" onclick=\"showFlow('step7', 'denied')\">\n            Denied\n          </button>\n        </div>\n        <div id=\"step7-approve\" class=\"flow-content approve\">\n          <p>\n            <strong>Approved:</strong> You will receive a email with a gift card\n            code you can use as a payment method for your next order. In caseyou\n            require us to refund the RMA amount via bank transfer, please inform\n            rma@4phones.eu.\n          </p>\n        </div>\n        <div id=\"step7-denied\" class=\"flow-content denied\">\n          <p>\n            <strong>Denied:</strong> If your RMA is denied, after twoweeks the\n            product will be disposed.In case you require the product to\n            bereturned, please inform us as soonas possible via\n            rma@4phones.eu,we will add the products to bereturned together with\n            your nextorder, or prepare a package to bepicked up by your carrier.\n          </p>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script>\n  function showFlow(step, flow) {\n    // Hide all flow content for this step\n    document\n      .querySelectorAll(`#${step}-approve, #${step}-denied`)\n      .forEach((el) => {\n        el.classList.remove(\"active\");\n      });\n\n    // Show the selected flow content\n    document.getElementById(`${step}-${flow}`).classList.add(\"active\");\n  }\n</script>",
        "color_scheme": "scheme-4",
