{% comment %}
  Renders a collection card with only the collection image (logo).
  Ensures the image displays correctly without height issues.
{% endcomment %}

<div class="card-wrapper">
  <div class="card card--media">
    <div class="card__inner">
      {%- if card_collection.featured_image -%}
        <div class="card__media">
          <div class="media media--transparent media--hover-effect">
            <a href="{{ card_collection.url }}">
              <img
                src="{{ card_collection.featured_image | image_url: width: 300 }}"
                alt="{{ card_collection.featured_image.alt | escape }}"
                loading="lazy"
                class="motion-reduce"
                width="300"
                height="{{ 300 | divided_by: card_collection.featured_image.aspect_ratio | round}}"
              >
            </a>
          </div>
        </div>
      {%- else -%}
        <div class="card__media">
          <a href="{{ card_collection.url }}">
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .card-wrapper,
  .card,
  .card__inner,
  .card__media,
  .media {
    height: auto; /* Allow height to adjust based on content */
  }

  .card__media img {
    width: 100%; /* Ensure the image fills the container */
    height: auto; /* Maintain aspect ratio */
    display: block; /* Remove extra space below the image */
  }

  /* Optional: Add borders for debugging */
  .card-wrapper,
  .card,
  .card__inner,
  .card__media,
  .media {
    border: 1px solid red;
  }
</style>
