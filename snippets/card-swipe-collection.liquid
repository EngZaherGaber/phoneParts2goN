{% comment %}
  Collection Horizontal Scroller
  Displays 6 collection images on desktop and 3 on mobile.
  Swipe functionality enabled for mobile devices.
{% endcomment %}

{{ 'https://cdnjs.cloudflare.com/ajax/libs/hammer.js/2.0.8/hammer.min.js' | script_tag }}

<style>
  /* Horizontal Scroll Container */
  .collection-scroll-wrapper {
    overflow-x: auto; /* Enable horizontal scrolling */
    white-space: nowrap; /* Prevent items from wrapping */
    -webkit-overflow-scrolling: touch; /* Smooth scrolling on mobile */
    scrollbar-width: none; /* Hide scrollbar for Firefox */
    padding: 16px; /* Add padding for better spacing */
  }

  .collection-scroll-wrapper::-webkit-scrollbar {
    display: none; /* Hide scrollbar for Chrome, Safari, and Opera */
  }

  .collection-scroll-container {
    display: inline-flex; /* Display items in a row */
    gap: 16px; /* Space between items */
  }

  /* Scroll Items */
  .scroll-item {
    display: inline-block; /* Ensure items stay in a row */
    width: calc(100% / 3 - 16px); /* Show 3 items on mobile */
    flex: 0 0 auto; /* Prevent flex items from shrinking */
  }

  .scroll-item img {
    width: 100%;
    height: auto;
    border-radius: 8px; /* Optional: Add rounded corners */
  }

  /* Desktop Styles */
  @media (min-width: 768px) {
    .scroll-item {
      width: calc(100% / 6 - 16px); /* Show 6 items on desktop */
    }
  }

  /* Optional: Scroll Snap for Better UX */
  .collection-scroll-container {
    scroll-snap-type: x mandatory;
  }

  .scroll-item {
    scroll-snap-align: start;
  }
</style>

<div class="collection-scroll-wrapper">
  <div class="collection-scroll-container">
    {% for collection in collections limit: 6 %}
      <!-- Adjust the limit as needed -->
      <div class="scroll-item">
        <a href="{{ collection.url }}">
          <img
            src="{{ collection.image | img_url: '300x' }}"
            alt="{{ collection.title }}"
            width="300"
            height="{{ 300 | divided_by: collection.image.aspect_ratio | round }}"
            loading="lazy"
          >
        </a>
      </div>
    {% endfor %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const scrollContainer = document.querySelector('.collection-scroll-wrapper');

    if (scrollContainer) {
      const hammer = new Hammer(scrollContainer);

      // Swipe left and right
      hammer.on('swipeleft', function () {
        scrollContainer.scrollBy({ left: 200, behavior: 'smooth' }); // Adjust scroll distance
      });

      hammer.on('swiperight', function () {
        scrollContainer.scrollBy({ left: -200, behavior: 'smooth' }); // Adjust scroll distance
      });
    }
  });
</script>
