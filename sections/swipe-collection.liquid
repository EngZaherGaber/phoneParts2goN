{% comment %}
  Collection Logo Scroller
  Displays a horizontal scroller of collection images (logos) with swipe functionality for mobile.
  Includes navigation arrows and customizable columns for mobile.
{% endcomment %}

<script src="{{ 'hammer.min.js' | asset_url }}" async></script>

<style>
  /* Logo Scroller Container */
  .logo-scroll-wrapper {
    position: relative;
    overflow-x: auto; /* Enable horizontal scrolling */
    white-space: nowrap; /* Prevent items from wrapping */
    -webkit-overflow-scrolling: touch; /* Smooth scrolling on mobile */
    scrollbar-width: none; /* Hide scrollbar for Firefox */
    padding: 16px 40px; /* Add padding for arrows */
  }

  .logo-scroll-wrapper::-webkit-scrollbar {
    display: none; /* Hide scrollbar for Chrome, Safari, and Opera */
  }

  .logo-scroll-container {
    display: inline-flex; /* Display items in a row */
    gap: 24px; /* Space between logos */
    padding: 0 16px; /* Padding for the container */
  }

  /* Logo Items */
  .logo-item {
    display: inline-block; /* Ensure items stay in a row */
    width: calc(100% / {{ section.settings.columns_mobile }} - 16px); /* Adjust width based on mobile columns */
    flex: 0 0 auto; /* Prevent flex items from shrinking */
  }

  .logo-item img {
    width: 100%;
    height: auto;
    border-radius: 8px; /* Optional: Add rounded corners */
    filter: grayscale(100%); /* Optional: Make logos grayscale */
    transition: filter 0.3s ease; /* Smooth transition for hover effect */
  }

  .logo-item img:hover {
    filter: grayscale(0%); /* Optional: Remove grayscale on hover */
  }

  /* Navigation Arrows */
  .scroll-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.5);
    color: white;
    border: none;
    padding: 10px;
    cursor: pointer;
    z-index: 1;
  }

  .scroll-arrow.left {
    left: 0;
  }

  .scroll-arrow.right {
    right: 0;
  }

  /* Desktop Styles */
  @media (min-width: 768px) {
    .logo-item {
      width: calc(100% / {{ section.settings.columns_desktop }} - 16px); /* Adjust width based on desktop columns */
    }
  }
</style>

<div class="logo-scroll-wrapper">
  <button class="scroll-arrow left" onclick="scrollLogos(-100)">&#10094;</button>
  <div class="logo-scroll-container">
    {% for collection in collections limit: section.settings.collection_limit %}
      <div class="logo-item">
        <a href="{{ collection.url }}">
          <img
            src="{{ collection.image | img_url: '200x' }}"
            alt="{{ collection.title }}"
            width="100"
            height="100"
            loading="lazy"
          >
        </a>
      </div>
    {% endfor %}
  </div>
  <button class="scroll-arrow right" onclick="scrollLogos(100)">&#10095;</button>
</div>

<script>
  // Function to scroll logos
  function scrollLogos(scrollAmount) {
    const scrollContainer = document.querySelector('.logo-scroll-container');
    scrollContainer.scrollBy({ left: scrollAmount, behavior: 'smooth' });
  }

  // Swipe functionality for mobile
  document.addEventListener('DOMContentLoaded', function () {
    const scrollContainer = document.querySelector('.logo-scroll-wrapper');

    if (scrollContainer && {{ section.settings.swipe_on_mobile | json }}) {
      const hammer = new Hammer(scrollContainer);

      // Swipe left and right
      hammer.on('swipeleft', function () {
        scrollLogos(100); // Adjust scroll distance
      });

      hammer.on('swiperight', function () {
        scrollLogos(-100); // Adjust scroll distance
      });
    }
  });
</script>

{% schema %}
{
  "name": "Collection Logo Scroller",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "collection_limit",
      "label": "Number of Collections to Show",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on Desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns on Mobile",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "default": true,
      "label": "Enable Swipe on Mobile"
    }
  ]
}
{% endschema %}
