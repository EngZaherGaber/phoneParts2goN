{{ 'customer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  /* Group Styling */
  fieldset.form-group {
    border: 0;
    padding: 20px;
    margin-bottom: 20px;
    box-shadow: 2px 3px 5px 0 var(--darkGreen);
    border-radius: 5px;
    background: linear-gradient(90deg, rgb(139 214 218), rgb(166 236 208)) !important;
  }
  /* Custom Checkbox Styling */
  .field-row input[type="checkbox"] {
    opacity: 0;
    /* Hide the default checkbox */
    position: absolute;
  }

  .field-row input[type="checkbox"] + label {
    position: relative;
    padding-left: 30px;
    /* Space for custom checkbox */
    cursor: pointer;
    display: inline-block;
    color: #333;
    /* Text color */
    font-size: 16px;
    /* Text size */
  }

  /* Custom checkbox design */
  .field-row input[type="checkbox"] + label::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 20px;
    /* Checkbox size */
    height: 20px;
    /* Checkbox size */
    border: 2px solid #ccc;
    /* Checkbox border */
    background-color: #fff;
    /* Checkbox background */
    border-radius: 4px;
    /* Rounded corners */
    transition: all 0.3s ease;
    /* Smooth transition */
  }

  /* Checkmark design (hidden by default) */
  .field-row input[type="checkbox"] + label::after {
    content: '';
    position: absolute;
    left: 7px;
    top: 3px;
    width: 6px;
    height: 12px;
    border: solid #fff;
    /* Checkmark color */
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
    opacity: 0;
    /* Hidden by default */
    transition: all 0.3s ease;
    /* Smooth transition */
  }

  /* Checkbox checked state */
  .field-row input[type="checkbox"]:checked + label::before {
    background-color: #007bff;
    /* Background color when checked */
    border-color: #007bff;
    /* Border color when checked */
  }

  .field-row input[type="checkbox"]:checked + label::after {
    opacity: 1;
    /* Show checkmark when checked */
  }

  /* Hover effect */
  .field-row input[type="checkbox"] + label:hover::before {
    border-color: #007bff;
    /* Border color on hover */
  }

  /* Focus state for accessibility */
  .field-row input[type="checkbox"]:focus + label::before {
    box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.25);
    /* Focus ring */
  }
  legend {
    font-weight: bold;
    padding: 0 10px;
  }

  /* Field Row Styling */
  .field-row {
    display: flex;
    gap: 20px;
    margin-bottom: 15px;
  }
  .flx-col {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
  }
  .field {
    flex: 1;
    margin: 0 !important;

  }
  .field input,
  .customer select {
  ;
  /* background: transparent !important; */
}

.field::after,
.field::before {
  content: none !important;
}
.field {
  margin-bottom: 20px !important;
  /* Spacing between fields */
  position: relative !important;
  /* For pseudo-elements */
}

.field input,
.field select {
  width: 100% !important;
  /* Full width */
  padding: 12px 16px !important;
  /* Comfortable padding */
  font-size: 16px !important;
  /* Readable font size */
  color: #333 !important;
  /* Text color */
  border: 2px solid #e0e0e0 !important;
  /* Subtle border */
  border-radius: 10px !important;
  /* Rounded corners */
  /* background-color: #fff !important; */
  /* White background */
  transition: all 0.3s ease !important;
  /* Smooth transition */
  outline: none !important;
  /* Remove default outline */
}

.field input:focus,
.field select:focus {
  border-color: #3ee9a5 !important;
  /* Highlight border on focus */
  box-shadow: 0 0 8px rgba(62, 233, 165, 0.3) !important;
  /* Glow effect on focus */
}


/* Hover Effect for Inputs */
.field input:hover,
.field select:hover {
  border-color: #45d5dc !important;
  /* Change border color on hover */
}

/* Gradient Border Effect on Focus */
.field input:focus,
.field select:focus {
  border-image-slice: 1 !important;
}

/* Placeholder Styling */
.field input::placeholder {
  color: #999 !important;
  /* Light placeholder text */
  font-style: italic !important;
  /* Italic placeholder */
}

/* Custom Select Arrow */
.field select {
  appearance: none !important;
  /* Remove default arrow */
  background-image: url("data:image/svg+xml !important;charset=UTF-8, %3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23333'%3E%3Cpath d='M7 10l5 5 5-5z'/%3E%3C/svg%3E") !important;
  background-repeat: no-repeat !important;
  background-position: right 12px center !important;
  background-size: 12px !important;
}

/* Checkbox and Radio Button Styling (if needed) */
.field input[type="checkbox"],
.field input[type="radio"] {
  width: auto !important;
  /* Reset width */
  margin-right: 8px !important;
  /* Spacing between checkbox and label */
}

/* Button Styling (Matching .no-cart) */
.field button {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: 100% !important;
  padding: 12px 24px !important;
  font-size: 16px !important;
  color: #fff !important;
  text-decoration: none !important;
  text-transform: uppercase !important;
  border-radius: 20px !important;
  background: linear-gradient(270deg, #3ee9a5, #45d5dc) !important;
  background-size: 200% 200% !important;
  background-position: 0 0 !important;
  transition: all 0.5s ease !important;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1) !important;
  border: none !important;
  cursor: pointer !important;
}

.field button:hover {
  background-position: 100% 100% !important;
  box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2) !important;
  transform: translateY(-2px) !important;
}

.field button:active {
  transform: translateY(0) !important;
}

/* Glossy Overlay for Button */
.field button::after {
  content: "" !important;
  position: absolute !important;
  top: 0 !important;
  left: 0 !important;
  width: 100% !important;
  height: 100% !important;
  background: linear-gradient(120deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0) 50%) !important;
  opacity: 0 !important;
  transition: opacity 0.3s ease !important;
}

.field button:hover::after {
  opacity: 1 !important;
}

/* Responsive Adjustments */
@media (max-width: 768px) {
  .field-row {
    flex-direction: column;
  }
}
@media screen and (min-width: 750px) {
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
}
{%- endstyle -%}

<div class="customer register section-{{ section.id }}-padding">
  <h1>
    {{ 'customer.register.title' | t }}
  </h1>
  {%- form 'create_customer'
    , novalidate: 'novalidate' -%}
    {%- if form.errors -%}
      <h2
        class="form__message"
        tabindex="-1"
        autofocus>
        <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
        {{ 'templates.contact.form.error_heading' | t }}
      </h2>
      <ul>
        {%- for field in form.errors -%}
          <li>
            {%- if field == 'form' -%}
              {{ form.errors.messages[field] }}
            {%- else -%}
              <a href="#RegisterForm-{{ field }}">
                {{ form.errors.translated_fields[field] | capitalize }}
                {{ form.errors.messages[field] }}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <!-- 1. Personal Information -->
    <fieldset class="form-group">
      <legend>Personal Information</legend>
      <div class="field-row">
        <div class="field">
          <input
            type="email"
            name="customer[email]"
            id="RegisterForm-email"
            {% if form.email %}
            value="{{ form.email }}"
            {% endif %}
            spellcheck="false"
            autocapitalize="off"
            autocomplete="email"
            aria-required="true"
            {% if form.errors contains 'email' %}
            aria-invalid="true"
            aria-describedby="RegisterForm-email-error"
            {% endif %}
            placeholder="{{ 'customer.register.email' | t }}"
            required>
          <label for="RegisterForm-email">{{ 'customer.register.email' | t }}</label>
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <input
            type="text"
            name="customer[first_name]"
            id="RegisterForm-FirstName"
            {% if form.first_name %}
            value="{{ form.first_name }}"
            {% endif %}
            autocomplete="given-name"
            placeholder="{{ 'customer.register.first_name' | t }}"
            required>
          <label for="RegisterForm-FirstName">{{ 'customer.register.first_name' | t }}</label>
        </div>
        <div class="field">
          <input
            type="text"
            name="customer[last_name]"
            id="RegisterForm-LastName"
            {% if form.last_name %}
            value="{{ form.last_name }}"
            {% endif %}
            autocomplete="family-name"
            placeholder="{{ 'customer.register.last_name' | t }}"
            required>
          <label for="RegisterForm-LastName">{{ 'customer.register.last_name' | t }}</label>
        </div>
      </div>
    </fieldset>

    <!-- 2. Password Fields -->
    <fieldset class="form-group">
      <legend>Password</legend>
      <div class="field-row">
        <div class="field">
          <input
            type="password"
            name="customer[password]"
            id="RegisterForm-Password"
            placeholder="Password"
            aria-required="true"
            required>
          <label for="RegisterForm-Password">Password</label>
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <input
            type="password"
            name="customer[confirm_password]"
            id="RegisterForm-ConfirmPassword"
            placeholder="Confirm Password"
            aria-required="true"
            required>
          <label for="RegisterForm-ConfirmPassword">Confirm Password</label>
        </div>
      </div>
      <div
        id="password-error"
        class="form__message"
        style="display: none; color: red;">
        Passwords do not match.
      </div>
    </fieldset>

    <!-- 3. Address Information -->
    <fieldset class="form-group">
      <legend>Address Information</legend>
      <div class="field-row">
        <div class="field">
          <select
            name="customer[metafields][custom.country]"
            id="RegisterForm-Country"
            required>
            <option value="">Select Country</option>
            {% assign european_countries = "Austria,Belgium,Bulgaria,Croatia,Cyprus,Czech Republic,Denmark,Estonia,Finland,France,Germany,Greece,Hungary,Ireland,Italy,Latvia,Lithuania,Luxembourg,Malta,Netherlands,Poland,Portugal,Romania,Slovakia,Slovenia,Spain,Sweden" | split: ',' %}
            {% for country in european_countries %}
              <option value="{{ country }}">{{ country }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="field">
          <input
            type="text"
            name="customer[metafields][custom.city]"
            id="RegisterForm-City"
            placeholder="City"
            required>
          <label for="RegisterForm-City">City</label>
        </div>
        <div class="field">
          <input
            type="text"
            name="customer[metafields][custom.zip_code]"
            id="RegisterForm-ZipCode"
            placeholder="Zip Code"
            required>
          <label for="RegisterForm-ZipCode">Zip Code</label>
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <input
            type="text"
            name="customer[metafields][custom.address1]"
            id="RegisterForm-Address1"
            placeholder="Address 1"
            required>
          <label for="RegisterForm-Address1">Address 1</label>
        </div>
        <div class="field">
          <input
            type="text"
            name="customer[metafields][custom.address2]"
            id="RegisterForm-Address2"
            placeholder="Address 2"
            required>
          <label for="RegisterForm-Address2">Address 2</label>
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <input
            type="text"
            name="customer[metafields][custom.company]"
            id="RegisterForm-Company"
            placeholder="Company"
            required>
          <label for="RegisterForm-Company">Company</label>
        </div>
      </div>
    </fieldset>

    <!-- 4. VAT Information -->
    <fieldset class="form-group">
      <legend>VAT Information</legend>
      <div class="field-row">
        <div class="field">
          <input
            type="text"
            name="customer[metafields][custom.vat_number]"
            id="RegisterForm-VATNumber"
            placeholder="VAT Number">
          <label for="RegisterForm-VATNumber">VAT Number</label>
        </div>
      </div>
    </fieldset>

    <!-- 5. Business License -->
    <fieldset class="form-group">
      <legend>Business License</legend>
      <div class="field-row">
        <div class="field" style="padding: 20px;">
          <input
            style="padding: 20px;"
            type="file"
            name="customer[metafields][custom.business_license]"
            id="RegisterForm-BusinessLicense">
          <label for="RegisterForm-BusinessLicense">Business License / Extract from the Commercial Register</label>
        </div>
      </div>
    </fieldset>

    <!-- 6. We Repair (Multi-Choice) -->
    <fieldset class="form-group">
      <legend>What They Repair (Multi-Choice)</legend>
      <div class="flx-col">
        <div class="field-row">
          <input
            type="checkbox"
            name="customer[metafields][custom.repair][]"
            value="Electronics"
            id="repair-electronics">
          <label for="repair-electronics">Electronics</label>
        </div>
        <div class="field-row">
          <input
            type="checkbox"
            name="customer[metafields][custom.repair][]"
            value="Appliances"
            id="repair-appliances">
          <label for="repair-appliances">Appliances</label>
        </div>
        <div class="field-row">
          <input
            type="checkbox"
            name="customer[metafields][custom.repair][]"
            value="Furniture"
            id="repair-furniture">
          <label for="repair-furniture">Furniture</label>
        </div>
      </div>
    </fieldset>

    <!-- 7. Our Services (Multi-Choice) -->
    <fieldset class="form-group">
      <legend>Our Services (Multi-Choice)</legend>
      <div class="flx-col">
        <div class="field-row">
          <input
            type="checkbox"
            name="customer[metafields][custom.services][]"
            value="Repair"
            id="service-repair">
          <label for="service-repair">Repair</label>
        </div>
        <div class="field-row">
          <input
            type="checkbox"
            name="customer[metafields][custom.services][]"
            value="Maintenance"
            id="service-maintenance">
          <label for="service-maintenance">Maintenance</label>
        </div>
        <div class="field-row">
          <input
            type="checkbox"
            name="customer[metafields][custom.services][]"
            value="Installation"
            id="service-installation">
          <label for="service-installation">Installation</label>
        </div>
      </div>
    </fieldset>

    <!-- 8. Contact Information -->
    <fieldset class="form-group">
      <legend>Contact Information</legend>
      <div class="field-row">
        <div class="field">
          <input
            type="tel"
            name="customer[metafields][custom.phone]"
            id="RegisterForm-Phone"
            placeholder="Phone"
            required>
          <label for="RegisterForm-Phone">Phone</label>
        </div>
        <div class="field">
          <input
            type="tel"
            name="customer[metafields][custom.whatsapp_number]"
            id="RegisterForm-WhatsAppNumber"
            placeholder="WhatsApp Number">
          <label for="RegisterForm-WhatsAppNumber">WhatsApp Number</label>
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <input
            type="url"
            name="customer[metafields][custom.website]"
            id="RegisterForm-Website"
            placeholder="Website">
          <label for="RegisterForm-Website">Website</label>
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <input
            type="url"
            name="customer[metafields][custom.facebook]"
            id="RegisterForm-Facebook"
            placeholder="Facebook">
          <label for="RegisterForm-Facebook">Facebook</label>
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <input
            type="url"
            name="customer[metafields][custom.instagram]"
            id="RegisterForm-Instagram"
            placeholder="Instagram">
          <label for="RegisterForm-Instagram">Instagram</label>
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <input
            type="url"
            name="customer[metafields][custom.linkedin]"
            id="RegisterForm-LinkedIn"
            placeholder="LinkedIn">
          <label for="RegisterForm-LinkedIn">LinkedIn</label>
        </div>
      </div>
    </fieldset>

    <button class="no-cart">{{ 'customer.register.submit' | t }}</button>
  {%- endform -%}
</div>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    const passwordField = document.getElementById('RegisterForm-Password');
    const confirmPasswordField = document.getElementById('RegisterForm-ConfirmPassword');
    const passwordError = document.getElementById('password-error');
    const form = document.querySelector('form[action$="/account"]');

    form.addEventListener('submit', function (e) {
      if (passwordField.value !== confirmPasswordField.value) {
        e.preventDefault(); // Prevent form submission
        passwordError.style.display = 'block'; // Show error message
        confirmPasswordField.focus(); // Focus on the confirm password field
      } else {
        passwordError.style.display = 'none'; // Hide error message
      }
    });
  });
</script>
{% schema %}
  {
    "name": "t:sections.main-register.name",
    "settings": [
      {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ]
  }
{% endschema %}