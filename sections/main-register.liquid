{{ 'customer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  /* Group Styling */
  fieldset.form-group {
    border: 1px solid #ccc;
    padding: 20px;
    margin-bottom: 20px;
    border-radius: 5px;
  }

  legend {
    font-weight: bold;
    padding: 0 10px;
  }

  /* Field Row Styling */
  .field-row {
    display: flex;
    gap: 20px;
    margin-bottom: 15px;
  }
  .flx-col {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
  }
  .field {
    flex: 1;
    margin: 0 !important;
  }

  /* Responsive Adjustments */
  @media (max-width: 768px) {
    .field-row {
      flex-direction: column;
    }
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="customer register section-{{ section.id }}-padding">
  <h1>
    {{ 'customer.register.title' | t }}
  </h1>
  {%- form 'create_customer'
    , novalidate: 'novalidate' -%}
    {%- if form.errors -%}
      <h2
        class="form__message"
        tabindex="-1"
        autofocus>
        <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
        {{ 'templates.contact.form.error_heading' | t }}
      </h2>
      <ul>
        {%- for field in form.errors -%}
          <li>
            {%- if field == 'form' -%}
              {{ form.errors.messages[field] }}
            {%- else -%}
              <a href="#RegisterForm-{{ field }}">
                {{ form.errors.translated_fields[field] | capitalize }}
                {{ form.errors.messages[field] }}
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <!-- 1. Personal Information -->
    <fieldset class="form-group">
      <legend>Personal Information</legend>
      <div class="field-row">
        <div class="field">
          <input
            type="email"
            name="customer[email]"
            id="RegisterForm-email"
            {% if form.email %}
            value="{{ form.email }}"
            {% endif %}
            spellcheck="false"
            autocapitalize="off"
            autocomplete="email"
            aria-required="true"
            {% if form.errors contains 'email' %}
            aria-invalid="true"
            aria-describedby="RegisterForm-email-error"
            {% endif %}
            placeholder="{{ 'customer.register.email' | t }}"
            required>
          <label for="RegisterForm-email">{{ 'customer.register.email' | t }}</label>
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <input
            type="text"
            name="customer[first_name]"
            id="RegisterForm-FirstName"
            {% if form.first_name %}
            value="{{ form.first_name }}"
            {% endif %}
            autocomplete="given-name"
            placeholder="{{ 'customer.register.first_name' | t }}"
            required>
          <label for="RegisterForm-FirstName">{{ 'customer.register.first_name' | t }}</label>
        </div>
        <div class="field">
          <input
            type="text"
            name="customer[last_name]"
            id="RegisterForm-LastName"
            {% if form.last_name %}
            value="{{ form.last_name }}"
            {% endif %}
            autocomplete="family-name"
            placeholder="{{ 'customer.register.last_name' | t }}"
            required>
          <label for="RegisterForm-LastName">{{ 'customer.register.last_name' | t }}</label>
        </div>
      </div>
    </fieldset>

    <!-- 2. Address Information -->
    <fieldset class="form-group">
      <legend>Address Information</legend>
      <div class="field-row">
        <div class="field">
          <input
            type="text"
            name="custom.company"
            id="RegisterForm-Company"
            placeholder="Company"
            required>
          <label for="RegisterForm-Company">Company</label>
        </div>

      </div>
      <div class="field-row">
        <div class="field">
          <input
            type="text"
            name="custom.address1"
            id="RegisterForm-Address1"
            placeholder="Address 1"
            required>
          <label for="RegisterForm-Address1">Address 1</label>
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <input
            type="text"
            name="custom.address2"
            id="RegisterForm-Address2"
            placeholder="Address 2"
            required>
          <label for="RegisterForm-Address2">Address 2</label>
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <input
            type="text"
            name="custom.city"
            id="RegisterForm-City"
            placeholder="City"
            required>
          <label for="RegisterForm-City">City</label>
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <select
            name="custom.country"
            id="RegisterForm-Country"
            required>
            <option value="">Select Country</option>
            {% assign european_countries = "Austria,Belgium,Bulgaria,Croatia,Cyprus,Czech Republic,Denmark,Estonia,Finland,France,Germany,Greece,Hungary,Ireland,Italy,Latvia,Lithuania,Luxembourg,Malta,Netherlands,Poland,Portugal,Romania,Slovakia,Slovenia,Spain,Sweden" | split: ',' %}
            {% for country in european_countries %}
              <option value="{{ country }}">{{ country }}</option>
            {% endfor %}
          </select>
        {% comment %} <label for="RegisterForm-Country">Country</label> {% endcomment %}
        </div>
        <div class="field">
          <input
            type="text"
            name="custom.zip_code"
            id="RegisterForm-ZipCode"
            placeholder="Zip Code"
            required>
          <label for="RegisterForm-ZipCode">Zip Code</label>
        </div>
      </div>
    </fieldset>

    <!-- 3. VAT Information -->
    <fieldset class="form-group">
      <legend>VAT Information</legend>
      <div class="field-row">
        <div class="field">
          <input
            type="text"
            name="custom.vat_number"
            id="RegisterForm-VATNumber"
            placeholder="VAT Number">
          <label for="RegisterForm-VATNumber">VAT Number</label>
        </div>
      </div>
    </fieldset>

    <!-- 4. Business License -->
    <fieldset class="form-group">
      <legend>Business License</legend>
      <div class="field-row">
        <div class="field">
          <input
            type="file"
            name="custom.business_license"
            id="RegisterForm-BusinessLicense">
          <label for="RegisterForm-BusinessLicense">Business License / Extract from the Commercial Register</label>
        </div>
      </div>
    </fieldset>

    <!-- 5. We Repair (Multi-Choice) -->
    <fieldset class="form-group">
      <legend>What They Repair (Multi-Choice)</legend>
      <div class="flx-col">
        <div class="field-row">
          <input
            type="checkbox"
            name="custom.repair[]"
            value="Electronics">
          <label for="">Electronics</label>
        </div>
        <div class="field-row">
          <input
            type="checkbox"
            name="custom.repair[]"
            value="Appliances">
          <label for="">Appliances</label>
        </div>
        <div class="field-row">
          <input
            type="checkbox"
            name="custom.repair[]"
            value="Furniture">
          <label for="">Furniture</label>
        </div>

      <!-- Add more options as needed -->
      </div>
    </fieldset>

    <!-- 6. Our Services (Multi-Choice) -->
    <fieldset class="form-group">
      <legend>Our Services (Multi-Choice)</legend>
      <div class="flx-col">
        <div class="field-row">
          <input
            type="checkbox"
            name="custom.services[]"
            value="Repair">
          <label for="">Repair</label>
        <!-- Add more options as needed -->
        </div>
        <div class="field-row">
          <input
            type="checkbox"
            name="custom.services[]"
            value="Maintenance">
          <label for="">Maintenance</label>
        </div>
        <div class="field-row">
          <input
            type="checkbox"
            name="custom.services[]"
            value="Installation">
          <label for="">Installation</label>
        </div>
      </div>
    </fieldset>

    <!-- 7. Contact Information -->
    <fieldset class="form-group">
      <legend>Contact Information</legend>
      <div class="field-row">
        <div class="field">
          <input
            type="tel"
            name="custom.phone"
            id="RegisterForm-Phone"
            placeholder="Phone"
            required>
          <label for="RegisterForm-Phone">Phone</label>
        </div>

        <div class="field">
          <input
            type="tel"
            name="custom.whatsapp_number"
            id="RegisterForm-WhatsAppNumber"
            placeholder="WhatsApp Number">
          <label for="RegisterForm-WhatsAppNumber">WhatsApp Number</label>
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <input
            type="url"
            name="custom.website"
            id="RegisterForm-Website"
            placeholder="Website">
          <label for="RegisterForm-Website">Website</label>
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <input
            type="url"
            name="custom.facebook"
            id="RegisterForm-Facebook"
            placeholder="Facebook">
          <label for="RegisterForm-Facebook">Facebook</label>
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <input
            type="url"
            name="custom.instagram"
            id="RegisterForm-Instagram"
            placeholder="Instagram">
          <label for="RegisterForm-Instagram">Instagram</label>
        </div>

      </div>
      <div class="field-row">
        <div class="field">
          <input
            type="url"
            name="custom.linkedin"
            id="RegisterForm-LinkedIn"
            placeholder="LinkedIn">
          <label for="RegisterForm-LinkedIn">LinkedIn</label>
        </div>
      </div>
    </fieldset>

    <button>{{ 'customer.register.submit' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
  {
    "name": "t:sections.main-register.name",
    "settings": [
      {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ]
  }
{% endschema %}